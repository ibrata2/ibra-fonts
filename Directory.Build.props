<Project>
  <!-- Shared settings for IBRA خطوط. The engine is JavaScript (web/) and is tested on Linux; the app (src/IbraFonts.App) is the Windows shell around it. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <Company>IBRAPROGRAM — ابراهيم الخزرجي</Company>
    <Product>IBRA خطوط</Product>
    <Copyright>من تصميم و تطوير و تعريب ابراهيم الخزرجي</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
</Project>
